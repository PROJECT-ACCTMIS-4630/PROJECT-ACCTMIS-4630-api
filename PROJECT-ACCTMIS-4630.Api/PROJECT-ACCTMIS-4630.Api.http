@PROJECT_ACCTMIS_4630_Api_HostAddress = http://localhost:5144

### POST a new Item to the Catalog collection
POST {{PROJECT_ACCTMIS_4630_Api_HostAddress}}/catalog
Content-Type: application/json

{
    "name": "Shoes",
    "description": "Ohio State shoes",
    "brand": "Nike",
    "price": 129.99
}

### POST a new rating to an Item
POST {{PROJECT_ACCTMIS_4630_Api_HostAddress}}/catalog/1/ratings
Content-Type: application/json

{
    "stars": 5,
    "userName": "testuser",
    "review": "Great shirt!"
}

### PUT an update to an Item
PUT {{PROJECT_ACCTMIS_4630_Api_HostAddress}}/catalog/1
Content-Type: application/json

{
    "id": 1,
    "name": "Shirt",
    "description": "Updated description",
    "brand": "Nike",
    "price": 39.99
}

